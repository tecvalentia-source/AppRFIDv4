<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/menu_card_white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvFilterEpc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/menu_brand_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="E280..." />

        <TextView
            android:id="@+id/tvFilterRssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:textSize="13sp"
            tools:text="-55 dBm" />

        <ProgressBar
            android:id="@+id/progressFilterRow"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressTint="@color/menu_card_orange" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
